# エディタの基本設定をそろえる(https://editorconfig.org)
# 改行コードは .gitattributes と同じく LF にする。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Markdown では行末の空白2つが改行の意味を持つため消さない
trim_trailing_whitespace = false
