.d-flex.flex-column.gap-2
  - if controller_name != 'sessions'
    = link_to "🔑 ログイン", new_session_path(resource_name), class: "text-decoration-none", style: "color: #4CAF50; font-weight: 500;"
  - if devise_mapping.registerable? && controller_name != 'registrations'
    = link_to "📝 新規登録", new_registration_path(resource_name), class: "text-decoration-none", style: "color: #4CAF50; font-weight: 500;"
  - if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations'
    = link_to "🔐 パスワードをお忘れの方", new_password_path(resource_name), class: "text-decoration-none", style: "color: #666; font-size: 0.9rem;"
  - if devise_mapping.confirmable? && controller_name != 'confirmations'
    = link_to "📧 確認メールが届いていない方", new_confirmation_path(resource_name), class: "text-decoration-none", style: "color: #666; font-size: 0.9rem;"
  - if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks'
    = link_to "🔓 アカウントロック解除", new_unlock_path(resource_name), class: "text-decoration-none", style: "color: #666; font-size: 0.9rem;"
  - if devise_mapping.omniauthable?
    - resource_class.omniauth_providers.each do |provider|
      = button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "btn btn-outline-secondary"
