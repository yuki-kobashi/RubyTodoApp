- if resource.errors.any?
  .alert.alert-danger.mb-4{"data-turbo-cache" => "false", style: "border-radius: 10px; border-left: 5px solid #dc3545; background: linear-gradient(135deg, #ffe0e0 0%, #ffebee 100%);"}
    %h6.alert-heading.fw-bold{style: "color: #dc3545;"}
      ❌
      = I18n.t("errors.messages.not_saved",                 |
        count: resource.errors.count,                       |
        resource: resource.class.model_name.human.downcase) |
    %ul.mb-0.ps-3
      - resource.errors.full_messages.each do |message|
        %li{style: "color: #721c24;"}= message
